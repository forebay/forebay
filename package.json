{
  "name": "forebay",
  "productName": "Forebay",
  "version": "0.1.0",
  "description": "Forebay, an Electron desktop control plane for managing AI providers, accounts, routing, and the local API across Claude Code and OpenCode.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "./out/main/index.js",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -b",
    "check:svelte": "svelte-check --tsconfig ./src/renderer/tsconfig.json",
    "check": "tsc -b && npm run check:svelte && npm run check:css",
    "check:css": "node scripts/css-scale.mjs",
    "gallery": "vite --config vite.gallery.config.ts",
    "gallery:build": "vite build --config vite.gallery.config.ts",
    "gallery:shots": "npm run gallery:build && electron scripts/gallery-shots.cjs --disable-gpu --force-device-scale-factor=1",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@intisy/bayonet": "^1.8.0",
    "@intisy-ai/basekit": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/svelte": "^5.4.2",
    "dompurify": "^3.4.12",
    "electron": "^32.0.0",
    "electron-vite": "^2.3.0",
    "jsdom": "^29.1.1",
    "marked": "^18.0.7",
    "svelte": "^5.0.0",
    "svelte-check": "^4.7.3",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
